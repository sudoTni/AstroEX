{
	"name": "astroex",
	"version": "0.13.0",
	"description": "Indeed job acquisition, filtering, evaluation, and materials-generation pipeline",
	"type": "commonjs",
	"main": "dist/index.js",
	"bin": {
		"astroex": "dist/index.js"
	},
	"files": [
		"dist",
		"config",
		"docs",
		"profile.example",
		"prompts",
		"sysprompts",
		".env.example",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "rimraf dist && tsc",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"start": "ts-node src/index.ts",
		"start:debug": "ts-node src/index.ts --headless false",
		"clean:data": "rimraf ./data",
		"acquire:jobs": "ts-node src/index.ts acquire-jobs",
		"process": "ts-node src/index.ts processData",
		"job:cloth": "ts-node src/index.ts jobCloth",
		"job:judge": "ts-node src/index.ts jobJudge",
		"makeMaterials": "ts-node src/index.ts makeMaterials",
		"pipeline": "ts-node src/index.ts run-pipeline",
		"test": "npm run build && node --test test/*.test.js",
		"check": "npm run typecheck && npm test",
		"audit": "npm audit",
		"test:file-discovery": "npm run build && node --test test/jobJudgeFileDiscovery.test.js",
		"test:jobdb-flow": "npm run build && node --test test/jobRepository.test.js test/jobJudgeFileDiscovery.test.js",
		"test:statistics": "npm run build && node --test test/statisticsCollector.test.js",
		"test:acquisition": "npm run build && node --test test/acquisition.test.js",
		"test:logging": "npm run build && node --test test/logging.test.js",
		"test:jobcloth-payload": "npm run build && node --test test/jobClothPayload.test.js",
		"test:remote-only": "npm run build && node --test test/remoteOnly.test.js",
		"lint": "rimraf dist && biome check .",
		"lint:fix": "rimraf dist && biome check --fix .",
		"format": "rimraf dist && biome format --write .",
		"format:check": "rimraf dist && biome format ."
	},
	"author": "AstroEX Contributors",
	"contributors": [
		{
			"name": "llpujol",
			"url": "https://github.com/llpujol"
		}
	],
	"license": "MIT",
	"dependencies": {
		"axios": "^1.19.0",
		"axios-retry": "^4.5.0",
		"chalk": "^4.1.0",
		"cheerio": "^1.2.0",
		"https-proxy-agent": "^7.0.6",
		"openai": "^5.0.0-beta.0",
		"socks-proxy-agent": "^8.0.5",
		"tiktoken": "^1.0.21",
		"turndown": "^7.2.4",
		"yargs": "^17.7.3",
		"zod": "^3.24.3"
	},
	"overrides": {
		"yargs": "^17.7.3"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^24.7.0",
		"@types/turndown": "^5.0.6",
		"@types/yargs": "^15.0.9",
		"prettier": "^3.6.2",
		"rimraf": "^5.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
