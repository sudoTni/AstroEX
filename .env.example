# Copy to a private shell environment or secret manager. Do not commit real keys.
OPENAI_API_KEY=
AEX_OR_API_KEY=
ASTROEX_INDEED_API_KEY=

# Keep personal profile data and mutable artifacts outside the checkout/package.
# ASTROEX_PROFILE_DIR=/absolute/path/to/profile
# ASTROEX_DATA_DIR=/absolute/path/to/data
# ASTROEX_LOG_DIR=/absolute/path/to/logs
# ASTROEX_MATERIALS_DIR=/absolute/path/to/materials

# Optional service-wide LLM safety limits and reasoning controls.
# ASTROEX_MAX_LLM_REQUESTS=100
# ASTROEX_MAX_LLM_OUTPUT_TOKENS=64000
# ASTROEX_MAX_TOTAL_LLM_OUTPUT_TOKENS=500000
# ASTROEX_LLM_DEADLINE_MS=3600000
# ASTROEX_HIDE_REASONING=1
# ASTROEX_REMOTE_ONLY=1
# ASTROEX_REMOTE_EVAL_PRESET=re_glm-5.3-flash

# Optional deployment configuration (e.g. for astroex_wrapper.bash or --deploy).
# AEX_DEPLOY=1
# AEX_DEPLOY_DESTINATION=GoogleDrive:/autoJobGen-src
