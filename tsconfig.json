{
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "./dist/",
		"target": "es2022",
		"sourceMap": true,
		"strict": true,
		"resolveJsonModule": true,
		"lib": ["es2022", "dom"],
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"typeRoots": ["node_modules/@types"]
	},
	"include": ["src/**/*.ts"],
	"exclude": [".git", "node_modules"]
}
